<div class="ccfii-join-page min-h-screen">
  <div
    x-data="{open: false}"
    id="menu"
    class="ccfii-join-menu w-full py-4 px-5 md:px-8 relative z-20"
    phx-update="ignore"
  >
    <div class="flex items-center justify-between max-w-6xl mx-auto">
      <ClaperWeb.BrandComponents.logo class="h-10 w-auto" />

      <div
        x-show="open"
        x-transition
        class="ccfii-join-menu-overlay fixed inset-0 z-50 flex flex-col items-center justify-center space-y-6 md:hidden"
        @click.away="open = false"
      >
        <button
          @click="open = false"
          class="absolute top-6 right-6"
          aria-label={gettext("Close menu")}
        >
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"
            >
            </path>
          </svg>
        </button>
        <a href="https://get.claper.co/" class="text-lg font-semibold transition-colors">
          {gettext("About")}
        </a>
        <%= if @current_user do %>
          <.link href={~p"/events"} class="btn btn-primary btn-lg">
            {gettext("Dashboard")}
          </.link>
        <% else %>
          <.link href={~p"/users/log_in"} class="btn btn-primary btn-lg">
            {gettext("Log in")}
          </.link>
        <% end %>
      </div>

      <button
        @click="open = true"
        class="ccfii-join-menu-toggle p-2 md:hidden"
        aria-label={gettext("Open menu")}
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          >
          </path>
        </svg>
      </button>

      <div class="hidden md:flex items-center gap-6">
        <a
          href="https://get.claper.co/"
          class="ccfii-join-link text-sm font-medium transition-colors"
        >
          {gettext("About")}
        </a>
        <%= if @current_user do %>
          <.link href={~p"/events"} class="btn btn-primary">
            {gettext("Dashboard")}
          </.link>
        <% else %>
          <.link href={~p"/users/log_in"} class="btn btn-primary">
            {gettext("Log in")}
          </.link>
        <% end %>
      </div>
    </div>
  </div>

  <div class="relative z-10 flex flex-col justify-center px-5 pb-14 pt-10 md:px-8 md:pb-20 md:pt-16">
    <div class="mx-auto w-full max-w-xl text-center">
      <div class="mb-14 md:mb-16">
        <h1 class="text-4xl font-bold text-[#F7EDED] font-display md:text-5xl">
          {gettext("Join the event")}
        </h1>
        <p class="mx-auto mt-4 max-w-md text-base text-[#B99B9B] md:text-lg">
          {gettext("Enter the code shared by the presenter")}
        </p>
      </div>

      <%= form_for :event, ~p"/join", ["phx-submit": "join", id: "form", class: "mx-auto max-w-lg"], fn f -> %>
        <div>
          <div class="mt-5 flex items-center gap-3 md:gap-4">
            <span class="text-2xl font-semibold text-[#B99B9B] md:text-4xl">#</span>
            {text_input(f, :code,
              required: true,
              autofocus: true,
              maxlength: 10,
              placeholder: "ABCD1234",
              id: "input",
              class:
                "join-code-input w-full px-3 py-4 text-center text-xl font-bold uppercase tracking-[0.15em] sm:text-2xl sm:tracking-[0.2em] md:px-4 md:text-5xl md:tracking-[0.28em]"
            )}
          </div>
        </div>

        <div class="mt-10 flex justify-center">
          <button
            type="submit"
            id="submit"
            phx-disable-with={gettext("Join")}
            class="btn btn-primary btn-lg min-w-44 px-10 shadow-none"
          >
            {gettext("Join")}
          </button>
        </div>

        <%= if @last_event do %>
          <div class="mt-10 border-t border-[#523D3D] pt-6">
            <p class="text-sm text-[#B99B9B]">{gettext("Return to your last event")}</p>
            <.link
              href={~p"/e/#{@last_event.code}"}
              class="ccfii-join-link mt-2 inline-flex items-center gap-2 text-base font-medium transition-colors"
            >
              <span>{@last_event.name}</span>
              <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 7l-10 10M8 7h9v9"
                >
                </path>
              </svg>
            </.link>
          </div>
        <% end %>
      <% end %>

      <div class="mt-16 text-sm text-[#B99B9B]">
        <span>{gettext("Are you a presenter?")}</span>
        <a
          href="https://get.claper.co/"
          class="ccfii-join-link ml-2 font-medium transition-colors"
        >
          {gettext("Start creating for free")}
        </a>
      </div>
    </div>
  </div>
</div>
